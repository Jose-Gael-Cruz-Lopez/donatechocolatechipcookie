{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "donatechocolatechipcookie",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "donate-cookie-community",
      "database_id": "c245a379-838f-4012-81ec-2452f191f929",
      "migrations_dir": "migrations"
    }
  ]
}
